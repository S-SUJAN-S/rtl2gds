# =============================================================================
# RTL-to-GDSII AI Automation - Environment Variables
# Copy this file to .env and insert at least ONE free API key:
#   cp .env.example .env
# =============================================================================

# Option 1: Groq Cloud API (Recommended: 500+ tokens/sec, ultra-low latency)
# Free Key Signup: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option 2: Google Gemini API (1 Million Token Context Window)
# Free Key Signup: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# Option 3: OpenRouter API (Multi-provider aggregator with free models)
# Free Key Signup: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Option 4: Local Ollama Server (Offline mode)
# OLLAMA_HOST=http://127.0.0.1:11434
