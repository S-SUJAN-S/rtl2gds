# =============================================================================
# RTL-to-GDSII AI Automation - .gitignore
# =============================================================================

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environment Variables & Secrets
.env
.env.local
secret/
*.key

# Simulation & Waveform Dumps
*.vcd
*.wdb
*.vvp
*.fsdb
*.evcd
*.out
*.obj
*.o
*.log
*sdpa_tb

# Gate-Level Netlists & Temporary Synthesis Outputs
*_netlist.v
*_synth.v

# Transient EDA Pipeline Outputs & Regression Runs
outputs/pipeline_runs/
outputs/stage1/
outputs/stage2/
outputs/sdpa_accelerator/
build/*.def
build/*.ys
build/*.v
build/*.tcl
!build/pnr.tcl
!build/synth.ys

# Large Silicon Manufacturing Files (Avoid GitHub 100MB Limit)
*.gds
!tools/gds3d-viewer/samples/*.gds
*.mag
*.lef
*.rpt.debug.gz
*.rpt.error.gz
tools/gds3d-viewer/digital_twin_audit/

# System & OS Files
.DS_Store
Thumbs.db
*.swp
*~

# OpenLane Transient Runs
OpenLane/
designs/**/runs/
